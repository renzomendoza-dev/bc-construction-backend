# Template for .env — copy this file to .env and fill in real values.
# This file IS committed to version control; .env is NOT.
# Values left blank below are environment-specific or sensitive and must be
# set explicitly before the app will run correctly. Values with a default
# shown (ports, size limits, log level) are safe, non-sensitive fallbacks
# that work as-is for most setups.
#
# NOTE on blank values: leave them blank HERE, but always fill them in in the
# real .env. An env var that is set-but-empty is NOT the same as unset —
# Spring's ${VAR:default} syntax only falls back to the default when the
# variable is absent entirely. A var passed through as an empty string
# overrides the default with empty, which fails in confusing ways (an empty
# CORS_ALLOWED_ORIGINS, for instance, allows no origins at all rather than
# reverting to the localhost defaults).

# --- App datasource connection (read by the Spring Boot app container) -------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- App server -----------------------------------------------------------
SERVER_PORT=8080

# --- File storage -----------------------------------------------------------
# STORAGE_LOCAL_PATH is the filesystem path INSIDE the app container where
# uploaded images are written (see FileStorageService) — make sure it matches
# whatever volume is mounted for it in docker-compose, or uploads will vanish
# when the container restarts. STORAGE_BASE_URL is the public URL prefix that
# gets stored in the database and served back to clients, so it must be
# reachable from the browser (not an internal container hostname).
STORAGE_LOCAL_PATH=
STORAGE_BASE_URL=

# --- Multipart upload limits -------------------------------------------------
# Enforced twice: by Spring's servlet layer during request parsing, and again
# inside FileStorageService (which reads spring.servlet.multipart.max-file-size
# for its own check). Keep MAX_REQUEST_SIZE >= MAX_FILE_SIZE, since the request
# total includes the file plus any other form fields.
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call /api/** — no
# trailing slashes (origins are matched exactly: scheme + host + port).
# Local dev typically wants: http://localhost:3000,http://localhost:5173
#
# Do NOT set this to "*". The app enables allowCredentials(true), and the CORS
# spec forbids a wildcard origin on credentialed requests — Spring will fail
# fast at startup rather than silently misbehave. List explicit origins.
CORS_ALLOWED_ORIGINS=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Postgres container initialization ---------------------------------------
# Must match DB_NAME/DB_USERNAME/DB_PASSWORD above since they describe the
# same database. A mismatch means the container creates one database while the
# app tries to connect to another, and startup fails with an unhelpful
# connection error.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API authentication --------------------------------------------------------
# Shared secret required in the X-API-Key header on every /api/** request.
# Swagger UI (/swagger-ui**), the OpenAPI descriptor (/api-docs), and the root
# redirect are exempt, so the docs stay browsable without a key.
#
# NO DEFAULT exists in application.yaml - if this is unset the app will not
# start. That is intentional (fail closed rather than boot unprotected).
#
# Generate a real value with:  openssl rand -hex 32
API_KEY=
