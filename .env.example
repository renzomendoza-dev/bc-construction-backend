# Template for local development environment variables.
# Copy this file to .env (which is gitignored) and adjust values as needed.
# For any other environment (staging, prod, etc.), copy it there too and
# fill in real values - never commit an actual .env file.

# --- App datasource connection (read by the Spring Boot app container) -------
# DB_HOST is the compose SERVICE name, not localhost — the app resolves it on
# the compose network. Use localhost only when running the app outside Docker.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=backend
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- App server -----------------------------------------------------------
SERVER_PORT=8080

# --- File storage -----------------------------------------------------------
# STORAGE_LOCAL_PATH is a path INSIDE the app container — make sure a volume is
# mounted there in docker-compose or uploaded images are lost on restart.
# (Running the app directly on the host instead of in Docker? Override this to
# a real local directory — on Windows, /app/uploads resolves to C:\app\uploads,
# which is probably not what you want.)
STORAGE_LOCAL_PATH=/app/uploads
# Public URL prefix stored in the DB and served to the browser, so it must be
# host-reachable — not an internal container hostname like http://app:8080.
STORAGE_BASE_URL=http://localhost:8080/uploads

# --- Multipart upload limits -------------------------------------------------
# Enforced by Spring's servlet layer AND re-checked inside FileStorageService.
# Keep MAX_REQUEST_SIZE >= MAX_FILE_SIZE (request total includes other fields).
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# --- CORS ---------------------------------------------------------------------
# Frontend origins allowed to call /api/** — comma-separated, no trailing
# slashes. These are the standard React (3000) and Vite (5173) dev ports; add
# or replace as needed for whichever dev server the frontend actually runs on.
# Never set this to "*" — the app enables credentials, and the CORS spec
# forbids wildcard origins on credentialed requests (Spring fails at startup).
# Required with no default when running with the prod profile.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ------------------------------------------------------------------
# Set to DEBUG to see service-layer detail while developing.
LOG_LEVEL=INFO

# --- Postgres container initialization ---------------------------------------
# Read directly by the official postgres image on first startup; must match
# DB_NAME/DB_USERNAME/DB_PASSWORD above since they describe the same database.
#
# NOTE: these only take effect on FIRST startup, when the data volume is empty.
# Changing them later has no effect until the volume is removed
# (docker compose down -v), because the image skips init on an existing volume.
POSTGRES_DB=backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Keycloak (OAuth2 Resource Server) ----------------------------------------
# Issuer URI for the Keycloak realm this app validates JWTs against.
# Spring Boot uses this to auto-discover the JWK Set for signature
# verification (via /.well-known/openid-configuration). Must match the
# realm your frontend/Keycloak clients actually authenticate against.
# Required, no default.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/bc-construction

# --- Keycloak Admin API (service account) --------------------------------------
# Required, no default - the app will fail to start without these. Used by the
# admin user-management feature (list/assign/revoke roles, activate/deactivate
# users) to call Keycloak's Admin REST API on your behalf.
#
# Setup needed in Keycloak first (one-time, in the Keycloak admin console):
#   1. Create a CONFIDENTIAL client with "Service accounts roles" enabled
#      (standard flow can be off if this client is admin-API-only).
#   2. Under that client's "Service account roles" tab, assign these
#      realm-management client roles: view-realm, view-users, query-users,
#      manage-users.
#   3. Copy the client's Client ID and Secret (Credentials tab) below.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
